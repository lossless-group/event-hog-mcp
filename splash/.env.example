# OpenPanel client ID for this splash (public by design: it appears in the HTML).
# Used by src/components/Analytics.astro, and only in production builds.
# On GitHub Pages it comes from the repo Variable OPENPANEL_CLIENT_ID, passed to
# the build in .github/workflows/pages.yml:
#   env: OPENPANEL_CLIENT_ID: ${{ vars.OPENPANEL_CLIENT_ID }}
# Never put OPENPANEL_CLIENT_SECRET here; browser tracking doesn't use it.
OPENPANEL_CLIENT_ID=
