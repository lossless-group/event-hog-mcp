---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { STATIC_SEO, REPO_URL } from '@lib/seo';

const base = import.meta.env.BASE_URL;

// ─── The program: one session per capability, grouped by phase ──────────
// The arc above the fold and the detail below both read from
// src/content/program/, so they can't drift apart.
const sessions = (await getCollection('program')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
const PHASES = [
  { key: 'before', label: 'Before', day: 'Day 0', line: 'Know the room before you walk in.' },
  { key: 'during', label: 'During', day: 'Days 1–3', line: 'Keep everything while you talk.' },
  { key: 'after', label: 'After', day: 'Day 4+', line: 'Turn the week into something.' },
];
const byPhase = PHASES.map((p) => ({
  ...p,
  sessions: sessions.filter((s) => s.data.phase === p.key),
}));

const PASSES = [
  {
    level: '1',
    name: 'No backend',
    line: 'Claude and the kit’s skills. You get a zip of markdown files and a CSV.',
    needs: 'Nothing to deploy. Single player.',
  },
  {
    level: '2',
    name: 'Shared on Cloudflare',
    line: 'One git repo per event on Cloudflare Artifacts, written by the whole team at once. Every write is signed. SQLite (D1) for people and companies; R2 for images.',
    needs: 'One Cloudflare Worker, yours or ours.',
  },
  {
    level: '3',
    name: 'Paired with your CRM',
    line: 'Contacts go on to your CRM after someone approves them. HubSpot works today; any other CRM gets an import file.',
    needs: 'A CRM connector next to event-hog.',
  },
];

const TREE = [
  ['prep/', 'who’s in the room, and why'],
  ['speakers/', 'sourced profiles'],
  ['contacts/', 'one file per person'],
  ['notes/', 'takeaways and ideas'],
  ['slides/', 'photos and notes, per session'],
  ['drafts/', 'never posted from here'],
  ['flash-cards/', 'the shared deck'],
  ['Contacts__Met.csv', 'everyone met, always current'],
];

const GUARANTEED = [
  'Every write is a git commit by the person who made it.',
  'Writes append. Known contact fields are never overwritten.',
  'Upload links are signed, single use, 15 minutes.',
  'Hosted HTML is sandboxed: no scripts, no forms.',
];
const ASKED = [
  'Search before logging; never invent a field.',
  'Create CRM records only after a yes.',
  'Draft posts; never post.',
];
---

<BaseLayout title={STATIC_SEO.root.title} description={STATIC_SEO.root.description}>
  <main>
    <!-- ─── Above the fold: the pitch, then the arc ──────────────────── -->
    <section class="hero">
      <div class="container">
        <div class="hero__top">
          <h1 class="hero__title">Work the room.<br /><span>Keep everything.</span></h1>
          <div class="hero__aside">
            <p class="hero__lede">
              One shared workspace for a team working a conference, inside
              Claude or Codex. Talk to it in plain words. Every note is a plain
              markdown file, signed by whoever wrote it.
            </p>
            <div class="hero__ctas">
              <a class="btn btn-primary" href={REPO_URL} target="_blank" rel="noopener">Get the source</a>
              <a class="btn" href="#run-it">Ways to run it</a>
            </div>
          </div>
        </div>

        <ol class="arc" aria-label="Before, during and after the event">
          {byPhase.map((phase) => (
            <li class="arc__phase">
              <p class="arc__day mono">{phase.day}</p>
              <h2 class="arc__name">{phase.label}</h2>
              <p class="arc__line">{phase.line}</p>
              <ul class="arc__items">
                {phase.sessions.map((s) => (
                  <li>
                    <a href={`#${s.id}`}>{s.data.title}</a>
                    {s.data.status === 'partial' && <span class="arc__wip mono" title={s.data.status_note}>soon</span>}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ─── The program, in detail ───────────────────────────────────── -->
    <section class="section" id="program">
      <div class="container">
        <header class="section__head">
          <p class="folio" data-num="01">The program</p>
          <p class="section__lede">
            Each item names the skill Claude loads and the tools it calls, so
            you can check it against the code.
          </p>
        </header>

        {byPhase.map((phase) => (
          <div class="program__phase">
            <h3 class="program__label">{phase.label}</h3>
            <ol class="program__rows">
              {phase.sessions.map((s) => (
                <li class="session" id={s.id}>
                  <span class="session__slot mono">{s.data.slot}</span>
                  <div>
                    <h4 class="session__title">{s.data.title}</h4>
                    <p class="session__body">{s.body}</p>
                    {s.data.status === 'partial' && s.data.status_note && (
                      <p class="session__note"><span class="mono">In progress</span> {s.data.status_note}</p>
                    )}
                  </div>
                  <p class="session__tools mono">
                    <span class="session__track">{s.data.track}</span>
                    {s.data.tools?.join(' · ')}
                  </p>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>

    <!-- ─── Ways to run it ───────────────────────────────────────────── -->
    <section class="section" id="run-it">
      <div class="container">
        <header class="section__head">
          <p class="folio" data-num="02">Three ways to run it</p>
          <p class="section__lede">
            Each makes the same workspace, so you can start with nothing and
            add the rest mid-week.
          </p>
        </header>
        <ol class="passes">
          {PASSES.map((p) => (
            <li class="pass">
              <p class="pass__level mono">Level {p.level}</p>
              <h3 class="pass__name">{p.name}</h3>
              <p class="pass__line">{p.line}</p>
              <p class="pass__needs mono">{p.needs}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ─── The workspace, and the fine print ────────────────────────── -->
    <section class="section">
      <div class="container split">
        <div>
          <p class="folio" data-num="03">The workspace</p>
          <p class="section__lede split__lede">Plain files anyone can read, with or without us.</p>
          <ul class="tree mono">
            {TREE.map(([path, what]) => (
              <li><span class="tree__path">{path}</span><span class="tree__what">{what}</span></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="folio" data-num="04">Fine print</p>
          <p class="section__lede split__lede">What the code enforces, and what it only asks the model to do.</p>
          <div class="fine">
            <ul class="fine__list fine__list--enforced">{GUARANTEED.map((g) => <li>{g}</li>)}</ul>
            <ul class="fine__list fine__list--asked">{ASKED.map((g) => <li>{g}</li>)}</ul>
          </div>
          <p class="fine__data">
            Your data stays yours: never looked at or used commercially.
            <a href={`${REPO_URL}/blob/main/DATA-POLICY.md`} target="_blank" rel="noopener">Data policy</a>
            ·
            <a href={`${REPO_URL}/blob/main/COLLABORATE.md`} target="_blank" rel="noopener">Collaborate</a>
            ·
            <a href={`${base}context-v/`}>Our reasoning</a>
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ─── Above the fold ─────────────────────────────────────────────── */
  .hero { padding: var(--space-12) 0 var(--space-8); }
  .hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: end;
  }
  .hero__title {
    font-size: clamp(3rem, 6.4vw, 5.6rem);
    line-height: 1.04;
  }
  .hero__title span {
    background: var(--color-sign-bg);
    color: var(--color-sign-fg);
    padding: 0.02em 0.12em 0;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .hero__lede { font-size: 1.12rem; color: var(--color-text-soft); max-width: 32em; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }

  /* The arc: three columns joined by a route line with arrows. */
  .arc {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--space-10);
    border-top: 2px solid var(--color-border-strong);
  }
  .arc__phase {
    position: relative;
    padding: var(--space-5) var(--space-6) 0 0;
  }
  .arc__phase + .arc__phase { padding-left: var(--space-6); border-left: 1px solid var(--color-border); }
  .arc__phase:not(:last-child)::after {
    content: '→';
    position: absolute;
    top: -0.85rem;
    right: -0.6rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    background: var(--color-sign-bg);
    color: var(--color-sign-fg);
    border-radius: 50%;
  }
  .arc__day { font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-dim); }
  .arc__name { font-size: 2.6rem; margin-top: var(--space-1); }
  .arc__line { color: var(--color-text-soft); margin-top: var(--space-1); }
  .arc__items { margin-top: var(--space-4); display: grid; gap: 6px; }
  .arc__items li { display: flex; align-items: baseline; gap: var(--space-2); }
  .arc__items li::before { content: '›'; color: var(--color-text-dim); }
  .arc__items a { color: var(--color-text); font-weight: 500; }
  .arc__items a:hover { color: var(--color-accent); }
  .arc__wip {
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 1px 5px;
    border: 1px solid var(--color-text-dim);
    border-radius: var(--radius-sm);
    color: var(--color-text-dim);
  }

  /* ─── Sections ───────────────────────────────────────────────────── */
  .section { padding-top: var(--space-16); }
  .section__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-4) var(--space-6); margin-bottom: var(--space-6); }
  .section__lede { color: var(--color-text-soft); max-width: 56ch; }

  /* ─── Program ────────────────────────────────────────────────────── */
  .program__phase { display: grid; grid-template-columns: 8rem minmax(0, 1fr); border-top: 1px solid var(--color-border-strong); }
  .program__label { font-size: 1.6rem; padding-top: var(--space-4); }
  .session {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) 15rem;
    gap: var(--space-5);
    padding: var(--space-4) 0;
    scroll-margin-top: 80px;
  }
  .session + .session { border-top: 1px solid var(--color-border); }
  .session:target .session__title { background: var(--color__sign); color: var(--color__ink); width: fit-content; padding: 0 4px; }
  .session__slot { font-size: 0.66rem; color: var(--color-text-dim); padding-top: 5px; }
  .session__title { font-size: 1.4rem; line-height: 1.05; }
  .session__body { color: var(--color-text-soft); font-size: 0.95rem; margin-top: var(--space-1); max-width: 62ch; }
  .session__note { margin-top: var(--space-2); font-size: 0.88rem; color: var(--color-text-dim); }
  .session__note .mono { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.1em; margin-right: 4px; color: var(--color-text); }
  .session__tools { font-size: 0.62rem; line-height: 1.7; color: var(--color-text-dim); padding-top: 5px; overflow-wrap: anywhere; }
  .session__track { display: block; color: var(--color-text); font-weight: 500; }

  /* ─── Passes ─────────────────────────────────────────────────────── */
  .passes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .pass {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-border-strong);
    border-radius: var(--radius-md);
  }
  .pass:last-child { border-top-color: var(--color-accent-warm); }
  .pass__level { font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-dim); }
  .pass__name { font-size: 1.9rem; margin: var(--space-1) 0 var(--space-3); }
  .pass__line { color: var(--color-text-soft); font-size: 0.96rem; flex: 1; }
  .pass__needs { margin-top: var(--space-4); font-size: 0.64rem; color: var(--color-text); }

  /* ─── Workspace + fine print ─────────────────────────────────────── */
  .split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-12); }
  .split__lede { margin: var(--space-3) 0 var(--space-4); }
  .tree { border-left: 2px solid var(--color-border-strong); padding-left: var(--space-4); font-size: 0.74rem; display: grid; gap: 7px; }
  .tree li { display: grid; grid-template-columns: 11rem 1fr; gap: var(--space-3); }
  .tree__path { color: var(--color-text); font-weight: 500; }
  .tree__what { color: var(--color-text-dim); }
  .fine { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }
  .fine__list { display: grid; gap: var(--space-2); align-content: start; font-size: 0.93rem; color: var(--color-text-soft); }
  .fine__list::before {
    display: block;
    font-family: var(--font__mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 2px;
  }
  .fine__list--enforced::before { content: 'Enforced in code'; }
  .fine__list--asked::before { content: 'Asked of the model'; }
  .fine__data { margin-top: var(--space-6); font-size: 0.93rem; color: var(--color-text-soft); }

  /* ─── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero__top, .split { grid-template-columns: 1fr; gap: var(--space-6); }
    .arc { grid-template-columns: 1fr; border-top: 0; }
    .arc__phase, .arc__phase + .arc__phase { padding: var(--space-4) 0; border-left: 0; border-top: 2px solid var(--color-border-strong); }
    .arc__phase:not(:last-child)::after { content: '↓'; top: auto; bottom: -0.75rem; right: auto; left: 0; }
    .session { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); }
    .program__phase { grid-template-columns: 1fr; }
    .passes { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .fine { grid-template-columns: 1fr; }
    .tree li { grid-template-columns: 1fr; gap: 0; }
  }
</style>
