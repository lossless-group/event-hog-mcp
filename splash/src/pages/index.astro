---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { STATIC_SEO, REPO_URL } from '@lib/seo';

const base = import.meta.env.BASE_URL;

// ─── The program: one session per capability, grouped by phase ──────────
const sessions = (await getCollection('program')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
const PHASES = [
  { key: 'before', label: 'Before', day: 'Day 0', blurb: 'Know the room before you walk in.' },
  { key: 'during', label: 'During', day: 'Days 1–3', blurb: 'Keep everything while you talk.' },
  { key: 'after', label: 'After', day: 'Day 4+', blurb: 'Turn the week into something.' },
];
const byPhase = PHASES.map((p) => ({
  ...p,
  sessions: sessions.filter((s) => s.data.phase === p.key),
}));

// ─── The badge's pseudo-QR: deterministic, generated at build time ──────
const QR = 11;
let seed = [...'event-hog'].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const rand = () => ((seed = (seed * 1103515245 + 12345) >>> 0) / 2 ** 32);
const finder = (r: number, c: number) => {
  const inBox = (r0: number, c0: number) => r >= r0 && r < r0 + 3 && c >= c0 && c < c0 + 3;
  return inBox(0, 0) || inBox(0, QR - 3) || inBox(QR - 3, 0);
};
const qrCells = Array.from({ length: QR * QR }, (_, i) => {
  const r = Math.floor(i / QR);
  const c = i % QR;
  return finder(r, c) || rand() > 0.52;
});

// ─── Things people actually say to it ───────────────────────────────────
const SAYINGS = [
  'Who is this?',
  'Log this person. We talked about cooling loads.',
  'Who have we met from Schneider?',
  "What's the plan for today?",
  'Write up these slides.',
  'Quiz me on the acronyms.',
  "Move today's contacts into the CRM.",
];

const LOST_AND_FOUND = [
  { lost: 'Badge photos, forgotten in a camera roll', found: 'One contact file per person, made from the photo' },
  { lost: 'Notes split across four phones', found: 'One shared workspace, every entry signed' },
  { lost: 'Two teammates met the same buyer, separately', found: 'Both conversations land in the same file' },
  { lost: '200 slide photos nobody reopens', found: 'Transcribed, summarized, searchable' },
  { lost: 'The CRM, updated a week too late', found: 'Proposed the same day, yours to approve' },
];

const PASSES = [
  {
    tier: 'All Access',
    name: 'Use our Cloudflare',
    ribbon: 'aa',
    gets: [
      'Copy one prompt, paste it into your agent, done',
      'A shared workspace per event: git repo, database, image host',
      'Attendee research with lead enrichment built in',
      'Contacts, meetings and follow-ups go to your CRM after a yes',
    ],
    needs: 'Nothing to deploy. Pick up your badge below.',
    cta: { label: 'Copy the prompt', href: '#connect' },
  },
  {
    tier: 'Exhibitor',
    name: 'Self host',
    ribbon: 'ex',
    gets: [
      'The same server, on your own Cloudflare account',
      'Your data never reaches us',
      'Your own people, your own enrichment key',
      'Fork it and change anything',
    ],
    needs: 'A Cloudflare account with Artifacts, D1 and R2.',
    cta: { label: 'Deploy your own', href: `${REPO_URL}#deploy-your-own` },
  },
];

// ─── Registration: the connector the copy-a-prompt widget points at ─────
const SERVER = import.meta.env.PUBLIC_EVENTHOG_SERVER ?? 'https://event-hog.tanujsiripurapu.workers.dev';
const LINK = '__EVENTHOG_URL__';
const PROMPT = [
  'Connect me to event-hog, a shared workspace for working a conference: prep before, contacts during, follow-ups after.',
  '',
  'My personal event-hog connector URL is:',
  LINK,
  "It works like a password. Don't share it or post it anywhere.",
  '',
  'Step 1. Add it as a remote MCP server (Streamable HTTP, no sign-in) named "event-hog". Use whichever applies to you:',
  `- Cursor: add "event-hog": { "url": "${LINK}" } under "mcpServers" in ~/.cursor/mcp.json (merge with what's there; create the file if it's missing). If the tools don't show up, tell me to toggle event-hog on in Cursor Settings > MCP.`,
  `- Claude Code: run  claude mcp add --transport http event-hog ${LINK}`,
  `- Codex: add these two lines to ~/.codex/config.toml:  [mcp_servers.event-hog]  and  url = "${LINK}"`,
  '- Claude (web, desktop or mobile), ChatGPT, or any app where you can\'t add servers yourself: walk me through it, one step at a time. In Claude it\'s Settings > Connectors > Add custom connector, name it event-hog, paste the URL, then Add. I\'ll come back and say "done".',
  '',
  'Step 2. Once event-hog\'s tools are available, call its get_started tool and follow what it says. If they don\'t appear in this chat, tell me to start a new chat and say "Use event-hog: get started".',
].join('\n');

const BOOTHS = [
  { id: 'A1', path: 'prep/', what: 'Who’s in the room and why they matter', area: 'prep' },
  { id: 'A2', path: 'speakers/', what: 'Sourced speaker profiles', area: 'speakers' },
  { id: 'B1', path: 'contacts/', what: 'One file per person. Every teammate’s touchpoints append', area: 'contacts', big: true },
  { id: 'B2', path: 'notes/', what: 'Session takeaways, themes, ideas', area: 'notes' },
  { id: 'C1', path: 'slides/', what: 'Photos, notes per slide, the talk told slide by slide', area: 'slides', big: true },
  { id: 'C2', path: 'drafts/', what: 'Post drafts. Never posted from here', area: 'drafts' },
  { id: 'C3', path: 'flash-cards/', what: 'The shared deck', area: 'cards' },
  { id: 'D1', path: 'exports/', what: 'CRM import files', area: 'exports' },
];

const GUARANTEED = [
  'Every write is a git commit authored as the person who made it.',
  'Writes add or append. A contact’s known fields are never overwritten.',
  'Upload links are signed, single use, and expire in 15 minutes.',
  'Recreated slides with scripts, or without a source credit, are refused.',
  'Hosted HTML is served sandboxed: no scripts, no forms.',
];
const ASKED = [
  'Search before logging someone, and never invent a field.',
  'Propose CRM records, and create them only after a yes.',
  'Draft posts; never post.',
  'Keep hallway conversations out of anything public.',
];
---

<BaseLayout title={STATIC_SEO.root.title} description={STATIC_SEO.root.description}>
  <main>
    <!-- ─── Hero ─────────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="container hero__grid">
        <div class="hero__copy">
          <p class="eyebrow hero__eyebrow">
            <span class="dot" aria-hidden="true"></span>
            Open source · MCP server · Works in Claude and Codex
          </p>
          <h1 class="hero__title">
            <span>Work the room.</span>
            <span class="hero__title--hot">Keep everything.</span>
          </h1>
          <p class="hero__lede">
            event-hog gives a team working a conference one shared workspace
            inside the AI they already use. Prep before. Contacts, notes and
            slides during. Follow-ups after. You talk to it in plain words, and
            nobody stops a conversation to fill in a form.
          </p>
          <div class="hero__ctas">
            <a class="btn btn-primary" href="#connect">Get connected</a>
            <a class="btn" href="#program">See the program</a>
            <a class="btn" href={REPO_URL} target="_blank" rel="noopener">Get the source</a>
          </div>
          <p class="hero__fine mono">
            Apache-2.0 · first worked the floor at the 7x24 Exchange, Fall 2026
          </p>
        </div>

        <div class="hero__badge-wrap" aria-hidden="true">
          <div class="lanyard">
            <span class="lanyard__strap lanyard__strap--l"></span>
            <span class="lanyard__strap lanyard__strap--r"></span>
            <span class="lanyard__clip"></span>
          </div>
          <div class="badge">
            <span class="badge__slot"></span>
            <div class="badge__head">
              <span>Any conference</span>
              <span>Any city</span>
            </div>
            <div class="badge__body">
              <p class="badge__hello">Hello</p>
              <p class="badge__we">we are</p>
              <p class="badge__name">event&#8209;hog</p>
              <p class="badge__role">Your team's memory at the show</p>
              <div class="badge__foot">
                <div class="qr">
                  {qrCells.map((on) => <span class={on ? 'on' : ''}></span>)}
                </div>
                <div class="badge__meta mono">
                  <span>Reg # 0.1.0</span>
                  <span>Priority A</span>
                  <span class="snout"><i></i><i></i></span>
                </div>
              </div>
            </div>
            <div class="badge__ribbon">All Access</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Ticker: what people say to it ─────────────────────────────── -->
    <section class="ticker" aria-label="Things people say to event-hog">
      <div class="ticker__track">
        {[0, 1].map((dup) => (
          <ul class="ticker__list" aria-hidden={dup === 1 ? 'true' : undefined}>
            {SAYINGS.map((s) => <li>“{s}”</li>)}
          </ul>
        ))}
      </div>
    </section>

    <!-- ─── Hall A: Lost & Found ─────────────────────────────────────── -->
    <section class="section" id="why">
      <div class="container lf">
        <div class="lf__intro">
          <p class="folio" data-num="A">Why it exists</p>
          <h2 class="section__title">The lost<br />&amp; found desk</h2>
          <p class="section__lede">
            A conference is days of conversations that matter, and most of them
            get lost. By the time anyone opens the CRM, the week is a blur.
            event-hog keeps it while you're still in the room.
          </p>
        </div>
        <ol class="lf__list">
          {LOST_AND_FOUND.map((item, i) => (
            <li class="lf__item">
              <span class="lf__no mono">{String(i + 1).padStart(3, '0')}</span>
              <span class="lf__lost">
                <span class="lf__tag mono">Lost</span>
                {item.lost}
              </span>
              <span class="lf__found">
                <span class="lf__tag lf__tag--found mono">Found</span>
                {item.found}
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ─── Hall B: The program ──────────────────────────────────────── -->
    <section class="section" id="program">
      <div class="container">
        <div class="section__head">
          <p class="folio" data-num="B">What it does</p>
          <h2 class="section__title">The program</h2>
          <p class="section__lede">
            Everything event-hog does, laid out like the agenda it's built for.
            Each session names the skill Claude loads and the tools it calls, so
            you can check the claim against the code.
          </p>
        </div>

        <div class="program">
          {byPhase.map((phase) => (
            <div class="program__phase">
              <header class="program__phase-head">
                <span class="program__day mono">{phase.day}</span>
                <h3 class="program__phase-name">{phase.label}</h3>
                <p class="program__phase-blurb">{phase.blurb}</p>
              </header>
              <ol class="program__rows">
                {phase.sessions.map((s) => (
                  <li class="session" data-status={s.data.status}>
                    <span class="session__slot mono">{s.data.slot}</span>
                    <div class="session__main">
                      <h4 class="session__title">{s.data.title}</h4>
                      <p class="session__body">{s.body}</p>
                      {s.data.status === 'partial' && s.data.status_note && (
                        <p class="session__note">
                          <span class="session__stamp mono">In progress</span>
                          {s.data.status_note}
                        </p>
                      )}
                    </div>
                    <div class="session__side">
                      <p class="session__room">
                        <span class="eyebrow">Room</span>
                        <span class="mono">{s.data.room}</span>
                      </p>
                      <p class="session__track">
                        <span class="eyebrow">Track</span>
                        <span class="chip">{s.data.track}</span>
                      </p>
                      {s.data.tools && s.data.tools.length > 0 && (
                        <ul class="session__tools" aria-label="Tools">
                          {s.data.tools.map((t) => <li class="mono">{t}</li>)}
                        </ul>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── Hall C: Passes ───────────────────────────────────────────── -->
    <section class="section" id="passes">
      <div class="container">
        <div class="section__head">
          <p class="folio" data-num="C">Two ways to run it</p>
          <h2 class="section__title">Pick your pass</h2>
          <p class="section__lede">
            Both passes run the same server and make the same workspace: plain
            markdown files, one per contact, and a CSV. Start on ours; move to
            your own when you want the data on your account.
          </p>
        </div>
        <ol class="passes">
          {PASSES.map((p, i) => (
            <li class={`pass pass--${p.ribbon}`} style={`--tilt:${[-1.2, 0.8][i]}deg`}>
              <span class="pass__slot" aria-hidden="true"></span>
              <p class="pass__level mono">Pass {i + 1}</p>
              <h3 class="pass__name">{p.name}</h3>
              <ul class="pass__gets">
                {p.gets.map((g) => <li>{g}</li>)}
              </ul>
              <p class="pass__needs"><span class="eyebrow">Needs</span> {p.needs}</p>
              <p class="pass__cta">
                <a
                  class={`btn ${i === 0 ? 'btn-primary' : ''}`}
                  href={p.cta.href}
                  {...(p.cta.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                >{p.cta.label}</a>
              </p>
              <p class="pass__ribbon">{p.tier}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ─── Registration: copy a prompt, get connected ───────────────── -->
    <section class="section" id="connect">
      <div class="container reg">
        <div class="reg__intro">
          <p class="folio" data-num="REG">Registration</p>
          <h2 class="section__title">Pick up your badge</h2>
          <p class="section__lede">
            Copy this prompt and paste it into Claude, ChatGPT, Cursor, Claude
            Code or Codex. It carries your own private link, and your agent
            connects itself, or walks you through the two clicks.
          </p>
          <ol class="reg__steps">
            <li>Your agent asks which company you represent and which conference you're going to.</li>
            <li>It works out whether you're before, during or after the show, and picks up from there.</li>
          </ol>
        </div>

        <div class="reg__desk" data-connect data-server={SERVER} data-template={PROMPT} data-placeholder={LINK}>
          <p class="reg__label mono">Your setup prompt</p>
          <textarea class="reg__prompt mono" readonly aria-label="Your setup prompt" data-prompt>Loading your link…</textarea>
          <div class="reg__actions">
            <button type="button" class="btn btn-primary" data-copy>Copy this prompt</button>
            <button type="button" class="btn" data-copy-link>Copy just my link</button>
          </div>
          <details class="reg__manual">
            <summary>Set it up by hand instead</summary>
            <p>Your link: <code class="chip" data-link></code></p>
            <ul>
              <li><b>Claude</b> (web, desktop, mobile): Settings, Connectors, Add custom connector. Name it event-hog and paste your link.</li>
              <li><b>Cursor</b>: add <code class="chip">"event-hog": {'{'} "url": "your link" {'}'}</code> under <code class="chip">mcpServers</code> in <code class="chip">~/.cursor/mcp.json</code>.</li>
              <li><b>Claude Code</b>: <code class="chip">claude mcp add --transport http event-hog your-link</code></li>
              <li><b>Codex</b>: in <code class="chip">~/.codex/config.toml</code>, add <code class="chip">[mcp_servers.event-hog]</code> with <code class="chip">url = "your link"</code>.</li>
            </ul>
          </details>
          <p class="reg__fine">
            Your link works like a password: anyone with it can write as you.
            This browser remembers it, so come back here to copy it again.
            Everything you log goes into a workspace shared with everyone on
            this deployment. event-hog never posts or emails anything, and never
            writes to your CRM by itself.
            <button type="button" class="reg__fresh" data-fresh>Make me a new link</button>
          </p>
        </div>
      </div>
    </section>

    <!-- ─── Hall D: Floor plan ───────────────────────────────────────── -->
    <section class="section" id="floor-plan">
      <div class="container">
        <div class="section__head">
          <p class="folio" data-num="D">The workspace</p>
          <h2 class="section__title">Floor plan</h2>
          <p class="section__lede">
            Every event gets the same layout: a folder of plain markdown files
            anyone can read, with or without us. Databases and CRMs are views of
            it, and can be rebuilt from it.
          </p>
        </div>
        <div class="floor">
          <div class="floor__map">
            {BOOTHS.map((b) => (
              <div class={`booth ${b.big ? 'booth--big' : ''}`} style={`grid-area:${b.area}`}>
                <span class="booth__id mono">{b.id}</span>
                <span class="booth__path mono">{b.path}</span>
                <span class="booth__what">{b.what}</span>
              </div>
            ))}
            <div class="booth booth--reg" style="grid-area:reg">
              <span class="booth__id mono">REG</span>
              <span class="booth__path mono">Contacts__Met.csv</span>
              <span class="booth__what">Everyone the team met, one row each. Always current. Import it anywhere.</span>
            </div>
            <div class="floor__entrance mono" style="grid-area:door">▲ Entrance · you are here</div>
          </div>
          <aside class="floor__legend">
            <p class="eyebrow">Legend</p>
            <ul>
              <li><span class="key key--line"></span> Every write is a commit, signed by whoever made it.</li>
              <li><span class="key key--dash"></span> Writes append. Nothing gets overwritten.</li>
              <li><span class="key key--fill"></span> Images live at a link. Files keep the link.</li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <!-- ─── Hall E: Fine print ───────────────────────────────────────── -->
    <section class="section" id="fine-print">
      <div class="container">
        <div class="section__head">
          <p class="folio" data-num="E">Fine print</p>
          <h2 class="section__title">What's enforced, what's asked</h2>
          <p class="section__lede">
            Some behaviour is guaranteed by the server's code. Some is an
            instruction to the model, which a model can fail to follow. We
            list both, because "does it do what we think it does?" is the
            first question a CTO should ask.
          </p>
        </div>
        <div class="fine">
          <div class="fine__col fine__col--enforced">
            <h3>The server guarantees</h3>
            <ul>{GUARANTEED.map((g) => <li>{g}</li>)}</ul>
          </div>
          <div class="fine__col fine__col--asked">
            <h3>It asks the model to</h3>
            <ul>{ASKED.map((g) => <li>{g}</li>)}</ul>
          </div>
        </div>
        <p class="fine__data">
          <strong>Your data is yours.</strong> On your own Cloudflare account it
          never reaches us. On ours, it's stored so your team can use it and is
          never looked at or used commercially.
          <a href={`${REPO_URL}/blob/main/DATA-POLICY.md`} target="_blank" rel="noopener">Read the data policy</a>.
        </p>
      </div>
    </section>

    <!-- ─── Collaborate ─────────────────────────────────────────────── -->
    <section class="section">
      <div class="container">
        <div class="cta">
          <div>
            <p class="eyebrow cta__eyebrow">Exhibitors wanted</p>
            <h2 class="cta__title">Fork it. Run it at your next show. Tell us what broke.</h2>
          </div>
          <div class="cta__links">
            <a class="btn btn-primary" href={`${REPO_URL}/blob/main/COLLABORATE.md`} target="_blank" rel="noopener">How to collaborate</a>
            <a class="btn" href={`${base}context-v/`}>Read the reasoning</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // The key is made here and kept in this browser. The server learns of it
  // the first time an agent calls with it, and makes the person then.
  const STORE = 'eventhog-key';
  const desk = document.querySelector<HTMLElement>('[data-connect]');
  if (desk) {
    const { server = '', template = '', placeholder = '' } = desk.dataset;
    const prompt = desk.querySelector<HTMLTextAreaElement>('[data-prompt]')!;
    const linkEl = desk.querySelector<HTMLElement>('[data-link]')!;

    const newKey = () =>
      Array.from(crypto.getRandomValues(new Uint8Array(24)), (b) => b.toString(16).padStart(2, '0')).join('');
    const key = () => {
      let k: string | null = null;
      try { k = localStorage.getItem(STORE); } catch {}
      if (!k || !/^[a-f0-9]{48}$/.test(k)) {
        k = newKey();
        try { localStorage.setItem(STORE, k); } catch {}
      }
      return k;
    };
    let url = '';
    const render = () => {
      url = `${server}/mcp/${key()}`;
      prompt.value = template.split(placeholder).join(url);
      linkEl.textContent = url;
    };
    const copy = async (text: string, btn: HTMLButtonElement) => {
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        prompt.focus();
        prompt.select();
        document.execCommand('copy');
      }
      const was = btn.textContent;
      btn.textContent = 'Copied. Now paste it into your agent.';
      setTimeout(() => { btn.textContent = was; }, 2500);
    };

    render();
    desk.querySelector<HTMLButtonElement>('[data-copy]')!.onclick = (e) =>
      copy(prompt.value, e.currentTarget as HTMLButtonElement);
    desk.querySelector<HTMLButtonElement>('[data-copy-link]')!.onclick = (e) =>
      copy(url, e.currentTarget as HTMLButtonElement);
    desk.querySelector<HTMLButtonElement>('[data-fresh]')!.onclick = () => {
      if (!confirm('Make a new link? Your agent keeps working with the old one; the new one starts as a new person.')) return;
      try { localStorage.removeItem(STORE); } catch {}
      render();
    };
  }
</script>

<style>
  /* ─── Shared section scaffolding ───────────────────────────────────── */
  .section { padding: var(--space-20) 0 0; }
  .section__head { max-width: 760px; margin-bottom: var(--space-10); }
  .section__title {
    font-size: clamp(3rem, 8vw, 5.6rem);
    margin: var(--space-4) 0 var(--space-4);
  }
  .section__lede { color: var(--color-text-soft); font-size: 1.08rem; max-width: 62ch; }

  /* ─── Hero ─────────────────────────────────────────────────────────── */
  .hero { padding: var(--space-16) 0 var(--space-12); overflow: hidden; }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }
  .hero__eyebrow { display: inline-flex; align-items: center; gap: var(--space-2); }
  .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--color-thread);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-thread) 25%, transparent);
  }
  .hero__title {
    display: flex;
    flex-direction: column;
    font-size: clamp(4rem, 11.5vw, 9.6rem);
    line-height: 0.84;
    letter-spacing: -0.005em;
    margin: var(--space-5) 0 var(--space-6);
  }
  .hero__title--hot { color: var(--color-accent-warm); }
  .hero__lede { font-size: 1.2rem; max-width: 34em; color: var(--color-text-soft); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }
  .hero__fine { margin-top: var(--space-6); font-size: 0.66rem; color: var(--color-text-dim); letter-spacing: 0.04em; }

  /* The lanyard and badge */
  .hero__badge-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
