---
import BaseLayout from '@layouts/BaseLayout.astro';
import { STATIC_SEO, REPO_URL } from '@lib/seo';

const PHASES = [
  {
    name: 'Before',
    items: [
      'Load the attendee list and pick who to meet.',
      'Look up speakers and the companies behind them.',
      'Flash cards for the acronyms you will hear.',
    ],
  },
  {
    name: 'During',
    items: [
      'Log someone from a sentence, a badge photo or a voice memo.',
      'Two teammates who meet the same person add to the same file.',
      'Photograph slides; your agent writes them up.',
    ],
  },
  {
    name: 'After',
    items: [
      'See who you met, who met them, and what you promised.',
      'Send contacts to HubSpot after you approve each one, or export a CSV.',
      'Fix a misspelled name or a wrong email. The old value stays in the history.',
      'Draft posts about the event. Nothing is posted for you.',
    ],
  },
];

const WAYS = [
  {
    name: 'Use ours',
    items: [
      'Copy the prompt above. Nothing to deploy.',
      "Runs on our Cloudflare account. Your team's events are private to your team.",
      'Attendee lookup is included.',
    ],
    cta: { label: 'Get connected', href: '#connect' },
  },
  {
    name: 'Run your own',
    items: [
      'The same server on your own Cloudflare account. Your data never reaches us.',
      'Needs Workers, Artifacts, D1 and R2.',
      'Your own people and your own lookup key. Fork it and change anything.',
    ],
    cta: { label: 'Deploy your own', href: `${REPO_URL}#deploy-your-own` },
  },
];

// The connector the copy-a-prompt widget points at.
const SERVER = import.meta.env.PUBLIC_EVENTHOG_SERVER ?? 'https://event-hog.tanujsiripurapu.workers.dev';
const LINK = '__EVENTHOG_URL__';
const PROMPT = [
  'Connect me to event-hog, a shared workspace for working a conference: prep before, contacts during, follow-ups after.',
  '',
  'My personal event-hog connector URL is:',
  LINK,
  "It works like a password. Don't share it or post it anywhere.",
  '',
  'Step 1. Add it as a remote MCP server (Streamable HTTP, no sign-in) named "event-hog". Use whichever applies to you:',
  `- Cursor: add "event-hog": { "url": "${LINK}" } under "mcpServers" in ~/.cursor/mcp.json (merge with what's there; create the file if it's missing). If the tools don't show up, tell me to toggle event-hog on in Cursor Settings > MCP.`,
  `- Claude Code: run  claude mcp add --transport http event-hog ${LINK}`,
  `- Codex: add these two lines to ~/.codex/config.toml:  [mcp_servers.event-hog]  and  url = "${LINK}"`,
  '- Claude (web, desktop or mobile), ChatGPT, or any app where you can\'t add servers yourself: walk me through it, one step at a time. In Claude it\'s Settings > Connectors > Add custom connector, name it event-hog, paste the URL, then Add. I\'ll come back and say "done".',
  '',
  'Step 2. Once event-hog\'s tools are available, call its get_started tool and follow what it says. If they don\'t appear in this chat, tell me to start a new chat and say "Use event-hog: get started".',
].join('\n');
---

<BaseLayout title={STATIC_SEO.root.title} description={STATIC_SEO.root.description}>
  <main>
    <section class="hero">
      <div class="container hero__grid">
        <div>
          <h1 class="hero__title">Work the room.<br /><span>Keep everything.</span></h1>
          <p class="hero__lede">
            event-hog is a shared notebook for your team at a conference. It
            runs inside the AI you already use (Claude, ChatGPT, Cursor or
            Codex), so logging someone you just met is one sentence to your
            agent.
          </p>
          <div class="hero__ctas">
            <a class="btn btn-primary" href="#connect">Get connected</a>
            <a class="btn" href={REPO_URL} target="_blank" rel="noopener">GitHub</a>
          </div>
          <p class="hero__fine">Open source. <a href="#run">Use ours, or run your own copy.</a></p>
        </div>

        <div class="hero__badge-wrap" aria-hidden="true">
          <div class="lanyard">
            <span class="lanyard__strap lanyard__strap--l"></span>
            <span class="lanyard__strap lanyard__strap--r"></span>
            <span class="lanyard__clip"></span>
          </div>
          <div class="badge">
            <span class="badge__slot"></span>
            <div class="badge__body">
              <p class="badge__hello">Hello</p>
              <p class="badge__we">we are</p>
              <p class="badge__name">event&#8209;hog</p>
              <p class="badge__role">Your team's memory at the show</p>
              <span class="snout"><i></i><i></i></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="connect">
      <div class="container reg">
        <div>
          <h2 class="section__title">Get connected</h2>
          <p class="section__lede">
            Copy this prompt into your agent. It includes your own private link,
            and your agent sets itself up or walks you through it.
          </p>
          <p class="section__lede">
            It then asks which company you're with and which conference you're
            going to. You get a private team; ask your agent to invite
            teammates.
          </p>
        </div>

        <div class="reg__desk" data-connect data-server={SERVER} data-template={PROMPT} data-placeholder={LINK}>
          <textarea class="reg__prompt mono" readonly aria-label="Your setup prompt" data-prompt>Loading your link…</textarea>
          <div class="reg__actions">
            <button type="button" class="btn btn-primary" data-copy>Copy this prompt</button>
            <button type="button" class="btn" data-copy-link>Copy just my link</button>
          </div>
          <details class="reg__manual">
            <summary>Set it up by hand</summary>
            <p>Your link: <code class="chip" data-link></code></p>
            <ul>
              <li><b>Claude</b> (web, desktop, mobile): Settings, Connectors, Add custom connector. Name it event-hog and paste your link.</li>
              <li><b>Cursor</b>: add <code class="chip">"event-hog": {'{'} "url": "your link" {'}'}</code> under <code class="chip">mcpServers</code> in <code class="chip">~/.cursor/mcp.json</code>.</li>
              <li><b>Claude Code</b>: <code class="chip">claude mcp add --transport http event-hog your-link</code></li>
              <li><b>Codex</b>: in <code class="chip">~/.codex/config.toml</code>, add <code class="chip">[mcp_servers.event-hog]</code> with <code class="chip">url = "your link"</code>.</li>
            </ul>
          </details>
          <p class="reg__fine">
            Treat the link like a password: anyone with it can write as you.
            This browser remembers it. If your team already uses event-hog, ask
            your admin for an invite instead.
            <button type="button" class="reg__fresh" data-fresh>Make me a new link</button>
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="how">
      <div class="container">
        <h2 class="section__title">What it does</h2>
        <div class="phases">
          {PHASES.map((p) => (
            <div class="phase">
              <h3 class="phase__name">{p.name}</h3>
              <ul>{p.items.map((item) => <li>{item}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="run">
      <div class="container">
        <h2 class="section__title">How it runs</h2>
        <div class="data__body">
          <p>
            event-hog is one Cloudflare Worker. Each event is its own git repo on
            <a href="https://developers.cloudflare.com/artifacts/" target="_blank" rel="noopener">Cloudflare Artifacts</a>,
            git storage built for agents. Every save your agent makes is a
            commit signed by you, so the whole team works from one history and a
            teammate's save never overwrites yours.
          </p>
          <p>
            Because it's plain git, you can download an event and open it in
            Obsidian or any editor. A database keeps the same contacts ready to
            query, and photos live in Cloudflare's file storage.
          </p>
        </div>
        <div class="ways">
          {WAYS.map((w, i) => (
            <div class="way">
              <h3 class="way__name">{w.name}</h3>
              <ul>{w.items.map((item) => <li>{item}</li>)}</ul>
              <a
                class={`btn ${i === 0 ? 'btn-primary' : ''}`}
                href={w.cta.href}
                {...(w.cta.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
              >{w.cta.label}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="data">
      <div class="container data">
        <h2 class="section__title">Your data</h2>
        <div class="data__body">
          <p>
            Each event is a folder of plain markdown files: one per person you
            met, plus a CSV of everyone. Nothing is lost: a correction keeps
            the old value, and every version stays in the history.
          </p>
          <p>
            Only people you invite can see your team's events. event-hog never
            posts, sends email, or writes to your CRM on its own.
          </p>
          <p>
            Read the <a href={`${REPO_URL}/blob/main/DATA-POLICY.md`} target="_blank" rel="noopener">data policy</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // The key is made here and kept in this browser. The server learns of it
  // the first time an agent calls with it, and makes the person then.
  const STORE = 'eventhog-key';
  const desk = document.querySelector<HTMLElement>('[data-connect]');
  if (desk) {
    const { server = '', template = '', placeholder = '' } = desk.dataset;
    const prompt = desk.querySelector<HTMLTextAreaElement>('[data-prompt]')!;
    const linkEl = desk.querySelector<HTMLElement>('[data-link]')!;

    const newKey = () =>
      Array.from(crypto.getRandomValues(new Uint8Array(24)), (b) => b.toString(16).padStart(2, '0')).join('');
    const key = () => {
      let k: string | null = null;
      try { k = localStorage.getItem(STORE); } catch {}
      if (!k || !/^[a-f0-9]{48}$/.test(k)) {
        k = newKey();
        try { localStorage.setItem(STORE, k); } catch {}
      }
      return k;
    };
    let url = '';
    const render = () => {
      url = `${server}/mcp/${key()}`;
      prompt.value = template.split(placeholder).join(url);
      linkEl.textContent = url;
    };
    const copy = async (text: string, btn: HTMLButtonElement) => {
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        prompt.focus();
        prompt.select();
        document.execCommand('copy');
      }
      const was = btn.textContent;
      btn.textContent = 'Copied. Now paste it into your agent.';
      setTimeout(() => { btn.textContent = was; }, 2500);
    };

    render();
    desk.querySelector<HTMLButtonElement>('[data-copy]')!.onclick = (e) =>
      copy(prompt.value, e.currentTarget as HTMLButtonElement);
    desk.querySelector<HTMLButtonElement>('[data-copy-link]')!.onclick = (e) =>
      copy(url, e.currentTarget as HTMLButtonElement);
    desk.querySelector<HTMLButtonElement>('[data-fresh]')!.onclick = () => {
      if (!confirm('Make a new link? Your agent keeps working with the old one; the new one starts as a new person.')) return;
      try { localStorage.removeItem(STORE); } catch {}
      render();
    };
  }
</script>

<style>
  .section { padding: var(--space-20) 0 0; }
  .section__title { font-size: clamp(2.4rem, 6vw, 3.6rem); margin-bottom: var(--space-5); }
  .section__lede { color: var(--color-text-soft); font-size: 1.08rem; max-width: 52ch; }
  .section__lede + .section__lede { margin-top: var(--space-4); }

  /* ─── Hero ─────────────────────────────────────────────────────────── */
  .hero { padding: var(--space-16) 0 0; overflow: hidden; }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }
  .hero__title {
    font-size: clamp(3.2rem, 8vw, 6.4rem);
    line-height: 0.9;
    margin-bottom: var(--space-6);
  }
  .hero__title span { color: var(--color-accent-warm); }
  .hero__lede { font-size: 1.2rem; max-width: 34em; color: var(--color-text-soft); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }
  .hero__fine { margin-top: var(--space-5); font-size: 0.9rem; color: var(--color-text-dim); }

  /* The lanyard and badge */
  .hero__badge-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: calc(var(--space-16) * -1);
    transform: rotate(-2deg);
    transform-origin: 50% 0;
  }
  .lanyard { position: relative; width: 200px; height: 170px; }
  .lanyard__strap {
    position: absolute;
    top: -40px;
    width: 26px;
    height: 210px;
    background: var(--color__lanyard);
    border: 2px solid var(--color-border-strong);
  }
  .lanyard__strap--l { left: 40px; transform: rotate(-16deg); transform-origin: bottom; }
  .lanyard__strap--r { right: 40px; transform: rotate(16deg); transform-origin: bottom; }
  .lanyard__clip {
    position: absolute;
    bottom: -14px;
    left: 50%;
    width: 34px;
    height: 34px;
    transform: translateX(-50%);
    border: 5px solid var(--color__concrete-400);
    border-radius: 8px 8px 50% 50%;
  }
  .badge {
    position: relative;
    width: min(340px, 100%);
    background: var(--color__card);
    color: var(--color__ink);
    border: 3px solid var(--color__ink);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-elevated);
  }
  .badge__slot {
    position: absolute;
    top: 12px;
    left: 50%;
    width: 64px;
    height: 12px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: var(--color-bg);
    border: 2px solid var(--color__ink);
  }
  .badge__body { position: relative; padding: 44px 22px 22px; }
  .badge__hello {
    font-family: var(--font__display);
    font-weight: 900;
    font-size: 4.2rem;
    line-height: 0.82;
    text-transform: uppercase;
    color: var(--color__hi-vis);
  }
  .badge__we { font-family: var(--font__mono); font-size: 0.72rem; margin: 4px 0 2px; }
  .badge__name {
    font-family: var(--font__display);
    font-weight: 800;
    font-size: 3rem;
    line-height: 1;
    text-transform: lowercase;
  }
  .badge__role { margin-top: 6px; font-size: 0.95rem; color: var(--color__concrete-700); }
  .snout {
    position: absolute;
    right: 22px;
    bottom: 22px;
    display: inline-flex;
    gap: 7px;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 36px;
    border-radius: 50%;
    background: var(--color__hog);
    border: 2.5px solid var(--color__ink);
  }
  .snout i { width: 8px; height: 12px; border-radius: 50%; background: var(--color__ink); }

  /* ─── Get connected ──────────────────────────────────────────────── */
  .reg {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: var(--space-12);
    align-items: start;
  }
  .reg__desk {
    padding: var(--space-6);
    background: var(--color-bg-card);
    border: 3px solid var(--color-border-strong);
  }
  .reg__prompt {
    display: block;
    width: 100%;
    height: 200px;
    padding: var(--space-4);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--color-text);
    background: var(--color-bg-soft);
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    resize: vertical;
  }
  .reg__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
  .reg__manual { margin-top: var(--space-5); color: var(--color-text-soft); font-size: 0.93rem; }
  .reg__manual summary { cursor: pointer; font-weight: 700; color: var(--color-text); }
  .reg__manual p, .reg__manual ul { margin-top: var(--space-3); }
  .reg__manual li { margin-top: var(--space-2); }
  .reg__manual .chip { white-space: normal; overflow-wrap: anywhere; }
  .reg__fine { margin-top: var(--space-5); font-size: 0.85rem; color: var(--color-text-dim); }
  .reg__fresh {
    display: block;
    margin-top: var(--space-3);
    padding: 0;
    font: inherit;
    color: var(--color-accent);
    text-decoration: underline;
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* ─── What it does ───────────────────────────────────────────────── */
  .phases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .phase { border-top: 3px solid var(--color-border-strong); padding-top: var(--space-4); }
  .phase__name { font-size: 1.8rem; margin-bottom: var(--space-3); }
  .phase ul { display: grid; gap: var(--space-3); }
  .phase li { color: var(--color-text-soft); }

  /* ─── How it runs, your data ─────────────────────────────────────── */
  .data__body { display: grid; gap: var(--space-4); max-width: 62ch; color: var(--color-text-soft); font-size: 1.05rem; }
  .ways {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    max-width: 960px;
    margin-top: var(--space-10);
  }
  .way {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--color-bg-card);
    border: 3px solid var(--color-border-strong);
  }
  .way__name { font-size: 1.8rem; }
  .way ul { display: grid; gap: var(--space-3); flex: 1; }
  .way li { color: var(--color-text-soft); }
  .way .btn { align-self: start; }

  @media (max-width: 980px) {
    .hero__grid, .reg { grid-template-columns: 1fr; }
    .hero__badge-wrap { margin-top: 0; }
    .phases, .ways { grid-template-columns: 1fr; gap: var(--space-6); }
  }
  @media (max-width: 640px) {
    .lanyard { transform: scale(0.8); }
  }
</style>
