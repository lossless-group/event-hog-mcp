// Fill in the <...> values for your own deployment (see README: Deploy your own).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "event-hog",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  // Skills and the event template ship inside the Worker (src/kit.generated.ts).
  "build": { "command": "node scripts/bundle-kit.mjs" },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "artifacts": [
    // One repo per event, plus the kit (event-hog-kit), in this namespace.
    { "binding": "ARTIFACTS", "namespace": "event-hog" },
    // Your CRM deployment's brain: CRM-specific skills, read after the kit's.
    { "binding": "BRAIN", "namespace": "<your-crm-brain-namespace>" }
  ],
  // event-hog-media: slide photos and other images, served at /media/<key>.
  // Repos keep the text (notes with the image's URL), not the image bytes.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "event-hog-media" }],
  // agnostic-crm: our structured model of people, orgs, events, touchpoints.
  "d1_databases": [
    {
      "binding": "CRM",
      "database_name": "agnostic-crm",
      "database_id": "<your D1 database id: npx wrangler d1 create agnostic-crm>",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Which event repo tools use when the caller doesn't name one.
    "DEFAULT_EVENT": "<yyyy-mm-event-slug>",
    "NAMESPACE": "event-hog",
    "EVENT_TIMEZONE": "America/Chicago",
    "BRAIN_NAMESPACE": "<your-crm-brain-namespace>",
    "SKILLS_REPO": "agent-skills",
    // event-hog's own package: CRM-agnostic skills, the event template, skill config.
    "KIT_REPO": "event-hog-kit",
    // This Worker's public URL. Capture pages, upload links and /media/ URLs use it.
    "PUBLIC_URL": "https://event-hog.<your-subdomain>.workers.dev"
    // Optional: send GET / somewhere else (eventhog.cc does this for the deployment
    // we run). Leave it out and the Worker serves its own copy-a-prompt page.
    // "HOME_URL": "https://eventhog.cc/#connect"
  }
  // Secrets (wrangler secret put):
  //   PEOPLE               optional JSON map of connector key -> { "name": "...", "email": "..." }
  //   ACCOUNT_ID           only used to build a remote URL if info() doesn't return one
  //   CONTEXT_DEV_API_KEY  optional; turns on enrich_people
}
